-- Hiệu ứng Hover cho nút
local function addHoverEffect(button, normalTrans, hoverTrans)
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = hoverTrans
        }):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = normalTrans
        }):Play()
    end)
end

addHoverEffect(CheckBtn, 0.1, 0)
addHoverEffect(GetBtn, 0.35, 0.15)

-- Hiệu ứng Focus ô nhập Key
KeyBox.Focused:Connect(function()
    TweenService:Create(InputStroke, TweenInfo.new(0.25), {Transparency = 0.1, Thickness = 1.6}):Play()
end)

KeyBox.FocusLost:Connect(function()
    TweenService:Create(InputStroke, TweenInfo.new(0.25), {Transparency = 0.65, Thickness = 1.2}):Play()
end)

-- Hiển thị thông báo dạng banner trượt mượt mà trên menu
local function showNotification(message, isSuccess)
    NotifyText.Text = message
    if isSuccess then
        NotifyStroke.Color = Color3.fromRGB(74, 222, 128)
        NotifyText.TextColor3 = Color3.fromRGB(74, 222, 128)
        NotifyBanner.BackgroundColor3 = Color3.fromRGB(10, 36, 24)
    else
        NotifyStroke.Color = Color3.fromRGB(248, 113, 113)
        NotifyText.TextColor3 = Color3.fromRGB(248, 113, 113)
        NotifyBanner.BackgroundColor3 = Color3.fromRGB(36, 15, 15)
    end
    
    NotifyBanner.Size = UDim2.new(0.84, 0, 0, 0)
    NotifyBanner.Visible = true
    
    TweenService:Create(NotifyBanner, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0.84, 0, 0, 26)
    }):Play()
end

-- Hiệu ứng lắc giảm chấn siêu mượt khi nhập sai key
local isShaking = false
local function smoothShake()
    if isShaking then return end
    isShaking = true

    local basePos = MainFrame.Position
    local offsets = {10, -10, 7, -7, 4, -4, 1.5, -1.5, 0}

    TweenService:Create(MainStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(248, 113, 113)}):Play()
    TweenService:Create(InputStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(248, 113, 113), Transparency = 0.1}):Play()

    for _, offset in ipairs(offsets) do
        local tween = TweenService:Create(
            MainFrame,
            TweenInfo.new(0.038, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            {Position = UDim2.new(basePos.X.Scale, basePos.X.Offset + offset, basePos.Y.Scale, basePos.Y.Offset)}
        )
        tween:Play()
        tween.Completed:Wait()
    end

    MainFrame.Position = basePos

    TweenService:Create(MainStroke, TweenInfo.new(0.35), {Color = Color3.fromRGB(56, 189, 248)}):Play()
    TweenService:Create(InputStroke, TweenInfo.new(0.35), {Color = Color3.fromRGB(56, 189, 248), Transparency = 0.65}):Play()

    isShaking = false
end

-- Hiệu ứng mở menu khi khởi động
MainFrame.Size = UDim2.new(0, 360, 0, 215)
MainFrame.BackgroundTransparency = 1
TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
    Size = UDim2.new(0, 400, 0, 240),
    BackgroundTransparency = 0.22
}):Play()

-- Xử lý Verify Key
CheckBtn.MouseButton1Click:Connect(function()
    local input = KeyBox.Text:gsub("%s+", "")
    if input == CORRECT_KEY then
        showNotification("✓ Key verified! Loading VN Hub...", true)
        saveKeySilently() -- Lưu key ngầm 24 giờ

        TweenService:Create(MainStroke, TweenInfo.new(0.25), {Color = Color3.fromRGB(74, 222, 128)}):Play()
        task.wait(0.6)

        local closeTween = TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 350, 0, 200),
            BackgroundTransparency = 1
        })
        closeTween:Play()
        closeTween.Completed:Wait()

        ScreenGui:Destroy()
        loadMainScript()
    else
        showNotification("⚠️ Invalid key! Please try again.", false)
        KeyBox.Text = "" -- Tự động xóa chữ khi nhập sai
        task.spawn(smoothShake)
    end
end)

-- Xử lý Get Key
GetBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(KEY_LINK)
        showNotification("🔗 Key link copied to clipboard!", true)
    else
        showNotification("⚠️ Executor doesn't support clipboard.", false)
    end
end)
